# Keep the build context small and secrets/data OUT of the image.
# The Dockerfile only COPYs pyproject.toml, uv.lock, src/, and README.md —
# everything else here is noise or must never be baked into a shared image.

# Secrets — never bake .env into an image (it ships to every registry pull).
.env
.env.*
!.env.example

# Local databases / state
*.db
mlflow.db

# Keep data/ out of the image EXCEPT the sample corpus, which the in-cluster seed
# Job needs (a pod can't reach your local disk). `data/*` (not `data/`) excludes
# the CONTENTS while leaving the dir re-includable, so the `!` negation works.
data/*
!data/sample_corpus

# Python / tooling caches and the local venv (rebuilt inside the image)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Repo metadata and things the runtime doesn't need
.git/
.github/
.gitignore
tests/
docs/
deploy/
EXERCISES.md
*.md
!README.md

# Editor / OS cruft
.vscode/
.idea/
.DS_Store
